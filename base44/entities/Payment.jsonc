{
  "name": "Payment",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "Reference to Invoice"
    },
    "invoice_number": {
      "type": "string",
      "description": "Denormalized invoice number"
    },
    "job_id": {
      "type": "string",
      "description": "Reference to Job"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email for receipt"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Payment date"
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "check",
        "credit_card",
        "debit_card",
        "bank_transfer",
        "other"
      ],
      "default": "cash",
      "description": "Payment method"
    },
    "reference": {
      "type": "string",
      "description": "Check number, transaction ID, or other reference"
    },
    "notes": {
      "type": "string"
    },
    "receipt_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether a receipt email has been sent"
    }
  },
  "required": [
    "invoice_id",
    "amount",
    "date"
  ]
}