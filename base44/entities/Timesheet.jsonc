{
  "name": "Timesheet",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Reference to Employee"
    },
    "employee_name": {
      "type": "string",
      "description": "Denormalized employee name for display"
    },
    "job_id": {
      "type": "string",
      "description": "Reference to Job"
    },
    "job_address": {
      "type": "string",
      "description": "Denormalized job address for display"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "clock_in": {
      "type": "string",
      "description": "Clock in time (HH:mm)"
    },
    "clock_out": {
      "type": "string",
      "description": "Clock out time (HH:mm)"
    },
    "hours": {
      "type": "number",
      "description": "Total hours worked"
    },
    "regular_hours": {
      "type": "number",
      "description": "Regular (non-overtime) hours for this entry"
    },
    "overtime_hours": {
      "type": "number",
      "description": "Overtime hours for this entry (above 40h/week)",
      "default": 0
    },
    "is_bank_holiday": {
      "type": "boolean",
      "description": "Whether this shift falls on a bank holiday",
      "default": false
    },
    "hourly_rate": {
      "type": "number",
      "description": "Snapshot of employee hourly rate at time of entry"
    },
    "wage_cost": {
      "type": "number",
      "description": "Calculated wage cost for this entry (inc. overtime/holiday premiums)"
    },
    "break_minutes": {
      "type": "number",
      "description": "Break time in minutes",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "employee_id",
    "job_id",
    "date",
    "clock_in"
  ]
}