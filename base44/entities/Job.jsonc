{
  "name": "Job",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Customer full name"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email address"
    },
    "customer_id": {
      "type": "string",
      "description": "Optional reference to Customer entity"
    },
    "address": {
      "type": "string",
      "description": "Job site address"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "new_roof",
        "repair",
        "inspection",
        "gutter",
        "siding",
        "maintenance",
        "other"
      ],
      "description": "Type of roofing job"
    },
    "roof_type": {
      "type": "string",
      "enum": [
        "asphalt_shingle",
        "metal",
        "tile",
        "flat",
        "slate",
        "wood_shake",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "estimate_scheduled",
        "estimate_sent",
        "approved",
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "lead"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "default": "medium"
    },
    "estimated_cost": {
      "type": "number"
    },
    "actual_cost": {
      "type": "number"
    },
    "description": {
      "type": "string",
      "description": "Detailed job description and notes"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "duration_days": {
      "type": "number",
      "description": "Estimated number of working days to complete the job"
    },
    "crew_required": {
      "type": "number",
      "description": "Number of crew members required for this job"
    },
    "assigned_employees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "General photo URLs (legacy)"
    },
    "photos_access": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Access & approach photos"
    },
    "photos_overall": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Overall roof photos"
    },
    "photos_damage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Damage photos"
    },
    "photos_interior": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Interior photos"
    },
    "photos_exterior": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Exterior / facade photos"
    },
    "roof_areas": {
      "type": "array",
      "description": "Individual roof areas/sections with their own details and photos",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Area name e.g. Front Slope, Rear Extension, Flat Roof"
          },
          "area_sq_ft": {
            "type": "number"
          },
          "roof_type": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "plan_of_action": {
      "type": "string",
      "description": "Detailed plan of action and scope of works"
    },
    "plan_materials_required": {
      "type": "string",
      "description": "Materials required for the job"
    },
    "plan_access_notes": {
      "type": "string",
      "description": "Access / site-specific notes for the crew"
    },
    "plan_health_safety": {
      "type": "string",
      "description": "Health & safety considerations"
    },
    "plan_timeline": {
      "type": "string",
      "description": "Estimated timeline and phasing"
    },
    "roof_condition": {
      "type": "string",
      "enum": [
        "new",
        "good",
        "fair",
        "poor",
        "critical"
      ]
    },
    "roof_age_years": {
      "type": "number"
    },
    "roof_area_sq_ft": {
      "type": "number"
    },
    "layers_count": {
      "type": "number"
    },
    "damage_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "material",
              "labor",
              "other"
            ]
          },
          "material_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "tax_rate": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "template_id": {
      "type": "string"
    },
    "template_name": {
      "type": "string"
    },
    "custom_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {}
        }
      }
    },
    "maintenance_contract_id": {
      "type": "string"
    },
    "maintenance_contract_name": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "address",
    "job_type"
  ]
}