{
  "name": "Job",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Customer full name"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email address"
    },
    "customer_id": {
      "type": "string",
      "description": "Optional reference to Customer entity"
    },
    "address": {
      "type": "string",
      "description": "Job site address"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "new_roof",
        "repair",
        "inspection",
        "gutter",
        "siding",
        "maintenance",
        "other"
      ],
      "description": "Type of roofing job"
    },
    "roof_type": {
      "type": "string",
      "enum": [
        "asphalt_shingle",
        "metal",
        "tile",
        "flat",
        "slate",
        "wood_shake",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "estimate_scheduled",
        "estimate_sent",
        "approved",
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "lead"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "default": "medium"
    },
    "estimated_cost": {
      "type": "number",
      "description": "Estimated cost of the job"
    },
    "actual_cost": {
      "type": "number",
      "description": "Actual cost upon completion"
    },
    "description": {
      "type": "string",
      "description": "Detailed job description and notes"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_employees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of assigned employee IDs"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photo URLs of the job site"
    },
    "roof_condition": {
      "type": "string",
      "enum": [
        "new",
        "good",
        "fair",
        "poor",
        "critical"
      ],
      "description": "Overall roof condition at intake"
    },
    "roof_age_years": {
      "type": "number",
      "description": "Age of the existing roof in years"
    },
    "roof_area_sq_ft": {
      "type": "number",
      "description": "Total roof area in square feet"
    },
    "layers_count": {
      "type": "number",
      "description": "Number of existing roofing layers"
    },
    "damage_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of damage present"
    },
    "line_items": {
      "type": "array",
      "description": "Materials and labour line items captured at intake",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "material",
              "labor",
              "other"
            ]
          },
          "material_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "tax_rate": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "template_id": {
      "type": "string",
      "description": "Reference to JobTemplate used for this job"
    },
    "template_name": {
      "type": "string",
      "description": "Denormalized template name"
    },
    "custom_fields": {
      "type": "array",
      "description": "Custom field values from the selected template",
      "items": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {}
        }
      }
    },
    "maintenance_contract_id": {
      "type": "string",
      "description": "Reference to MaintenanceContract if this job was generated from one"
    },
    "maintenance_contract_name": {
      "type": "string",
      "description": "Denormalized contract name"
    }
  },
  "required": [
    "customer_name",
    "address",
    "job_type"
  ]
}