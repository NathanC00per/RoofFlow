{
  "name": "PhoneRouting",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Route description (e.g., 'Customer Inquiries')"
    },
    "routing_type": {
      "type": "string",
      "enum": [
        "role",
        "employee",
        "round_robin"
      ],
      "description": "How to route: to specific role, specific employee, or round-robin"
    },
    "target_role": {
      "type": "string",
      "description": "Role to route to (when routing_type='role')"
    },
    "target_employee_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Employee IDs to route to (when routing_type='employee')"
    },
    "target_employee_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Denormalized employee names"
    },
    "forward_number": {
      "type": "string",
      "description": "Optional phone number to forward to (if no agent available)"
    },
    "ring_timeout": {
      "type": "number",
      "default": 30,
      "description": "Seconds before forwarding if no answer"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Higher priority routes are tried first"
    },
    "after_hours_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable after-hours handling"
    },
    "business_hours": {
      "type": "object",
      "description": "Business hours configuration per day (0=Sunday, 6=Saturday)",
      "properties": {
        "monday": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "start_time": {
              "type": "string",
              "description": "HH:mm format (e.g., '09:00')",
              "default": "09:00"
            },
            "end_time": {
              "type": "string",
              "description": "HH:mm format (e.g., '17:00')",
              "default": "17:00"
            }
          }
        },
        "tuesday": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "start_time": {
              "type": "string",
              "default": "09:00"
            },
            "end_time": {
              "type": "string",
              "default": "17:00"
            }
          }
        },
        "wednesday": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "start_time": {
              "type": "string",
              "default": "09:00"
            },
            "end_time": {
              "type": "string",
              "default": "17:00"
            }
          }
        },
        "thursday": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "start_time": {
              "type": "string",
              "default": "09:00"
            },
            "end_time": {
              "type": "string",
              "default": "17:00"
            }
          }
        },
        "friday": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "start_time": {
              "type": "string",
              "default": "09:00"
            },
            "end_time": {
              "type": "string",
              "default": "17:00"
            }
          }
        },
        "saturday": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "start_time": {
              "type": "string",
              "default": "09:00"
            },
            "end_time": {
              "type": "string",
              "default": "17:00"
            }
          }
        },
        "sunday": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "start_time": {
              "type": "string",
              "default": "09:00"
            },
            "end_time": {
              "type": "string",
              "default": "17:00"
            }
          }
        }
      }
    },
    "after_hours_mode": {
      "type": "string",
      "enum": [
        "voicemail",
        "forward",
        "emergency"
      ],
      "default": "voicemail",
      "description": "voicemail = play message, forward = redirect to number, emergency = emergency line"
    },
    "after_hours_message": {
      "type": "string",
      "description": "Custom voicemail message to play outside business hours"
    },
    "after_hours_forward_number": {
      "type": "string",
      "description": "Phone number to forward after-hours calls to"
    },
    "after_hours_emergency_number": {
      "type": "string",
      "description": "Emergency contact number for critical after-hours issues"
    }
  },
  "required": [
    "description",
    "routing_type"
  ]
}