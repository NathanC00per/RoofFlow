{
  "name": "Customer",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Primary email \u2014 used for portal login"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "portal_password_hash": {
      "type": "string",
      "description": "Simple hash of the portal password (set by admin on first invite)"
    },
    "portal_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the customer has portal access"
    },
    "gdpr_consent": {
      "type": "boolean",
      "default": false,
      "description": "Customer has accepted GDPR / data processing terms"
    },
    "gdpr_consent_date": {
      "type": "string",
      "format": "date",
      "description": "Date GDPR consent was given"
    },
    "portal_first_login": {
      "type": "boolean",
      "default": true,
      "description": "True until customer has logged in and set their own password"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ]
}